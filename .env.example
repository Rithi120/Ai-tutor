GROQ_API_KEY=your_groq_api_key_here
APP_ENV=development
# AI_MODE is cached or live. Cached serves a repeated request from disk and still
# refuses a miss unless ALLOW_LIVE_AI is set; live always calls Groq.
AI_MODE=live
# Required before development cached misses or live mode may call Groq.
ALLOW_LIVE_AI=false
# Optional model pricing for local estimated-cost accounting.
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0
AI_MAX_REQUESTS_PER_USER_HOUR=60
AI_MAX_REQUESTS_PER_USER_DAY=250
# Premium administrators are existing Learnova usernames or emails, comma-separated.
PREMIUM_ADMIN_IDENTIFIERS=
# Plans and free allowances (docs/SUBSCRIPTIONS.md). All optional; these are the defaults.
# Never put an activation code here: codes exist only on the admin screen at issuance.
PREMIUM_MONTHLY_PRICE_EUR=3.00
PREMIUM_CODE_DURATION_MONTHS=1
PREMIUM_CODE_MAX_DURATION_MONTHS=12
PREMIUM_CODE_VALIDITY_DAYS=90
# Shown under the cash instructions in Settings -> Subscription (plain text, max 500 chars).
PREMIUM_PAYMENT_INSTRUCTIONS=
PREMIUM_REDEEM_ATTEMPTS_PER_ACCOUNT=5
PREMIUM_REDEEM_ATTEMPTS_PER_SOURCE=20
PREMIUM_REDEEM_WINDOW_MINUTES=15
APP_TIMEZONE=Europe/Berlin
FREE_PROJECTS_PER_WINDOW=1
FREE_PROJECT_WINDOW_DAYS=7
FREE_LESSONS_PER_DAY=2
# Free AI assistant allowance in internal credits per period (day | week | month).
# 1 credit = 1 input token on a weight-1 model; output tokens count FREE_CHAT_OUTPUT_WEIGHT.
FREE_CHAT_CREDITS_PER_PERIOD=150000
FREE_CHAT_PERIOD=day
FREE_CHAT_OUTPUT_WEIGHT=4
# Cost weight per provider or provider:model, e.g. groq=1,openai=5,anthropic:claude-x=8
FREE_CHAT_MODEL_WEIGHTS=
QUOTA_RESERVATION_TTL_MINUTES=15
# A student who hits their own cap is paused for this many hours and told so plainly
# ("You have reached your limit. AI help is back at ..."). 0 = no cooldown.
AI_USER_COOLDOWN_HOURS=6
AI_MAX_LIVE_REQUESTS_DEVELOPMENT=1000
AI_MAX_OUTPUT_CHARACTERS=200000
# Comma-separated usernames or emails allowed to view /internal/ai-diagnostics (any
# environment; empty hides the page everywhere).
AI_DIAGNOSTICS_ADMINS=
# Token budgets (learnova/ai_services/budgets.py). Calendar UTC day/month windows. Unset
# user/site caps mean no limit, as before. A provider other than Groq is OFF until it has
# a cap: AI_BUDGET_<PROVIDER>_TOKENS_PER_DAY or _PER_MONTH switches it on.
AI_BUDGET_USER_TOKENS_PER_DAY=
AI_BUDGET_USER_TOKENS_PER_MONTH=
AI_BUDGET_GLOBAL_TOKENS_PER_DAY=2000000
AI_BUDGET_GLOBAL_TOKENS_PER_MONTH=
AI_BUDGET_GROQ_TOKENS_PER_DAY=
AI_BUDGET_OPENAI_TOKENS_PER_MONTH=
AI_BUDGET_ANTHROPIC_TOKENS_PER_MONTH=
AI_BUDGET_GEMINI_TOKENS_PER_MONTH=
# Requests per minute per provider, and optional prices per million tokens. A currency
# cap (AI_BUDGET_GLOBAL_SPEND_PER_MONTH) is only enforced for providers that have prices.
AI_RATE_GROQ_REQUESTS_PER_MINUTE=
AI_COST_OPENAI_INPUT_PER_MILLION=
AI_COST_OPENAI_OUTPUT_PER_MILLION=
AI_BUDGET_GLOBAL_SPEND_PER_MONTH=
AI_BUDGET_RESERVATION_TTL_MINUTES=10
# Cache entries older than this are misses (0 = never); identical requests within this
# many seconds share one provider call (0 = off).
AI_CACHE_TTL_DAYS=30
AI_DEDUP_WINDOW_SECONDS=15
AI_MAX_PROVIDER_CALLS_PER_REQUEST=3
# Keys for the other providers. A provider with no key is not offered.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Direct assistant chat (/assistant). A model may be written as "provider:model"
# (openai:gpt-5); a bare name goes to Groq as it always has. Set OPENAI_API_KEY to make
# openai: models available; see docs/ASSISTANT.md for adding Anthropic.
FEATURE_ASSISTANT_CHAT=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ASSISTANT_MODEL=openai/gpt-oss-20b
ASSISTANT_DEEP_MODEL=openai/gpt-oss-120b
# Per-style assistant models (students pick the style; you pick what answers it).
# Unset = the global ASSISTANT_MODEL / ASSISTANT_DEEP_MODEL. Styles: GENERAL, RESEARCH,
# STUDY_COACH, EXPLAIN. Example: ASSISTANT_MODEL_RESEARCH=anthropic:claude-sonnet-5
ASSISTANT_MODEL_RESEARCH=
ASSISTANT_DEEP_MODEL_RESEARCH=
# Premium models for the hard tasks only: final/hard answer grading and exam grading
# (GRADING), mistake diagnosis and the assistant's think-harder/research styles
# (REASONING). "provider:model". Unset = premium off; those tasks stay on Groq. A paid
# provider also needs a key and an AI_BUDGET_<PROVIDER>_* cap before it is used, and a
# failing premium call always falls back to Groq. Verify ids with
#   ALLOW_LIVE_AI_TESTS=true python scripts/live_ai_smoke_test.py --task models
# Verified live on 2026-10-01: gemini:gemini-3.8-flash (a free-tier key allows 5 calls a
# minute per model - enough for a premium slot, not for general use).
AI_PREMIUM_REASONING_MODEL=
AI_PREMIUM_GRADING_MODEL=
# Tried last, after every Groq model, when its provider has a key and budget. Unset =
# Groq is the floor and a Groq outage is reported as "temporarily unavailable".
AI_FALLBACK_MODEL=
# The slower model a student gets when a model's rate limit is hit (tried after the tier
# fallback, before AI_FALLBACK_MODEL). Unset = the tier fallback is the slower model.
AI_SLOW_MODEL=
# What the conversation history is trimmed to, and how much of that is held back so the
# model has room to answer a question arriving at the edge of the window.
ASSISTANT_CONTEXT_TOKEN_BUDGET=8000
ASSISTANT_REPLY_TOKEN_RESERVE=2000
ASSISTANT_MAX_MESSAGE_CHARACTERS=16000
ASSISTANT_MAX_CONVERSATIONS=200
ASSISTANT_MAX_MESSAGES_PER_CONVERSATION=400
AI_ASSISTANT_CHAT_MAX_OUTPUT_TOKENS=2000
# Per-task budgets use AI_<TASK>_MAX_INPUT_TOKENS and AI_<TASK>_MAX_OUTPUT_TOKENS.
# A textbook vocabulary page read as rows (word, translation, examples) in one call.
AI_VOCABULARY_PAGE_EXTRACTION_MAX_OUTPUT_TOKENS=3000
AI_TUTOR_CHAT_MAX_OUTPUT_TOKENS=1200
AI_ANSWER_EVALUATION_MAX_OUTPUT_TOKENS=2200
AI_TRANSLATION_MAX_OUTPUT_TOKENS=2500
AI_LESSON_GENERATION_MAX_OUTPUT_TOKENS=2200
AI_QUIZ_GENERATION_MAX_OUTPUT_TOKENS=600
AI_PROJECT_SECTION_GENERATION_MAX_OUTPUT_TOKENS=1200
AI_FINAL_EXAM_GENERATION_MAX_OUTPUT_TOKENS=1200
AI_OCR_DOCUMENT_RECOGNITION_MAX_OUTPUT_TOKENS=4000
AI_ADAPTIVE_PRACTICE_MAX_OUTPUT_TOKENS=2200
AI_FINAL_EXAM_EVALUATION_MAX_OUTPUT_TOKENS=5000
AI_ANSWER_DIAGNOSIS_MAX_OUTPUT_TOKENS=2600
AI_DIAGNOSIS_VERIFICATION_MAX_OUTPUT_TOKENS=300
AI_QUESTION_GENERATION_MAX_OUTPUT_TOKENS=1200
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TUTOR_MODEL=openai/gpt-oss-20b
GROQ_FAST_MODEL=openai/gpt-oss-20b
# The in-lesson tutor chat model ("provider:model" allowed). Quality beats cost on this
# surface; routing keeps the fast model behind it as the rate-limit fallback.
AI_TUTOR_CHAT_MODEL=openai/gpt-oss-120b
# Adaptive diagnostics models. Each stage is configurable so quality and cost can
# be traded per stage; all must be models the Groq account can actually reach.
GROQ_ANALYSIS_MODEL=openai/gpt-oss-120b
GROQ_DIAGNOSIS_MODEL=openai/gpt-oss-120b
GROQ_DIAGNOSIS_VERIFY_MODEL=openai/gpt-oss-20b
GROQ_QUESTION_MODEL=openai/gpt-oss-20b
# A second independent critique is only bought above this deterministic risk score.
# Set to 1.01 to disable verification calls entirely.
AI_DIAGNOSIS_VERIFY_RISK_THRESHOLD=0.6
# Extra attempts allowed when a generated question fails deterministic validation.
AI_QUESTION_MAX_REGENERATIONS=1
# Knowledge-gated tests: a test asks between MIN and MAX questions and stops once every
# concept is known at KNOWLEDGE_TARGET percent (evidence-weighted, see README). Wrong open
# exam answers diagnosed at submission, lowest scores first (each is a model call).
TEST_MIN_QUESTIONS=3
TEST_MAX_QUESTIONS=15
KNOWLEDGE_TARGET=80
EXAM_DIAGNOSIS_LIMIT=3
LESSON_TOKEN_LIMIT=2200
ANSWER_TOKEN_LIMIT=2200
CHAT_TOKEN_LIMIT=1100
TRANSLATE_TOKEN_LIMIT=2500
SECRET_KEY=replace_with_a_long_random_value
DATABASE_URL=sqlite:///learnova.db
PORT=5000
RATELIMIT_STORAGE_URI=memory://
FEATURE_FLASHCARD_PDF_IMPORT=true
FEATURE_FLASHCARD_IMAGE_IMPORT=true
FEATURE_COMMUNITY_LIBRARY=true
FEATURE_COMMUNITY_PUBLISHING=true
# Community moderation. On by default; production forces it on whenever publishing is
# enabled, because a public library without a safety gate is not a supported configuration.
FEATURE_COMMUNITY_MODERATION=true
# Usernames or emails allowed into the reviewer queue at /internal/moderation. Empty means
# nobody can reach it: escalated content stays unpublished rather than being exposed.
COMMUNITY_MODERATORS=
# Administrator alerts for reader reports and re-review findings (docs/COMMUNITY_MODERATION.md).
# Alerts are always stored and listed on /internal/moderation; they are emailed only when
# MAIL_SMTP_HOST and MAIL_FROM are set. Never commit the password - set it in the host's
# secret store. For Gmail use an app password (Google account > Security > App passwords),
# smtp.gmail.com, port 587, MAIL_SMTP_SECURITY=starttls. "sent" means the SMTP server
# accepted the message; check `flask community alerts` and the moderation page.
COMMUNITY_ALERT_EMAIL=maheswariskillbridge@gmail.com
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
# starttls | ssl | none (none refuses to log in to anything but localhost)
MAIL_SMTP_SECURITY=starttls
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_FROM=
MAIL_TIMEOUT_SECONDS=10
MAIL_MAX_ATTEMPTS=3
# Absolute site address for links in alert emails, e.g. https://learnova.example.org
PUBLIC_BASE_URL=
# Cost limits on AI re-reviews of reports: per set per day, site-wide per hour, and total
# attempts for one review before an administrator is told it keeps failing.
REPORT_REVIEW_MAX_PER_SET_DAY=5
REPORT_REVIEW_MAX_PER_HOUR=60
REPORT_REVIEW_MAX_ATTEMPTS=3
# Automatic re-checks of a set whose safety check could not run, before an alert.
MODERATION_RETRY_MAX_ATTEMPTS=3
# Obfuscation risk at which the stronger model is bought for a second opinion. 1.01
# disables escalation; 0 escalates everything.
MODERATION_ESCALATION_RISK_THRESHOLD=0.25
# Policy thresholds. Confidence a safety flag needs before it becomes a rejection rather
# than an escalation; the severe categories sit lower and must not exceed the ordinary
# one. Retune these against real decisions - they are calibrated on synthetic cases.
MODERATION_REJECT_CONFIDENCE=0.75
MODERATION_REJECT_CONFIDENCE_SEVERE=0.55
# Below this the classifier is not trusted to clear content on its own.
MODERATION_MIN_ALLOW_CONFIDENCE=0.40
# Reader reports that auto-hide published content pending a human check.
MODERATION_SAFETY_REPORT_THRESHOLD=2
MODERATION_TOTAL_REPORT_THRESHOLD=5
MODERATION_QUOTE_RETENTION_DAYS=90
# Above this a submission is held for revision rather than partially checked. Moderating
# a prefix and publishing the whole thing would be the worst of both.
MODERATION_MAX_CONTENT_CHARACTERS=40000
MODERATION_MAX_REPORTS_PER_USER_DAY=20
AI_CONTENT_MODERATION_MAX_OUTPUT_TOKENS=900
# Learning modes and platform gamification default on in development/testing and
# default off in production unless explicitly enabled.
FEATURE_FLASHCARD_LEARN_MODE=true
FEATURE_FLASHCARD_TEST_MODE=true
FEATURE_FLASHCARD_MATCH_GAME=true
FEATURE_FLASHCARD_BLAST_GAME=true
FEATURE_FLASHCARD_BLOCKS_GAME=true
FEATURE_GAMIFICATION=true
FEATURE_MISSIONS=true
FEATURE_BADGES=true
FEATURE_DAILY_GOALS=true
FEATURE_VOCABULARY_TRAINER=true
# Evidence-based mistake diagnosis and adaptive planning. Turning this off falls
# back to the previous mistake-analysis path; grading keeps working either way.
FEATURE_ADAPTIVE_DIAGNOSTICS=true
FEATURE_DIAGNOSTIC_VERIFICATION=true
# Baden-Württemberg Bildungsplan grounding (docs/CURRICULUM.md). A no-op until documents
# are imported. Cleared hosts start empty: list a host only after checking its usage terms.
FEATURE_CURRICULUM=true
CURRICULUM_CLEARED_SOURCES=
CURRICULUM_CONTEXT_MAX_CHARS=1800
GAMIFICATION_MIN_DAILY_EVENTS=3
# Learnova Leagues and profiles (docs/PROFILES_AND_LEAGUES.md). Learners can opt out of
# leagues in Settings; this switches them off for the whole site.
FEATURE_LEAGUES=true
LEAGUE_PROMOTE=10
LEAGUE_DEMOTE=10
LEAGUE_GROUP_SIZE=30
USERNAME_CHANGE_COOLDOWN_DAYS=30
USERNAME_HOLD_DAYS=90
MAX_FLASHCARD_PDF_SIZE=10485760
MAX_FLASHCARD_IMAGE_SIZE=8388608
MAX_FLASHCARD_PDF_PAGES=30
MAX_FLASHCARD_IMAGE_PIXELS=24000000
MAX_FLASHCARD_EXTRACTED_TEXT_LENGTH=30000
FLASHCARD_IMPORT_RETENTION_HOURS=24
FLASHCARD_EXTRACTION_TIMEOUT_SECONDS=45
MAX_FLASHCARD_IMPORTS_PER_HOUR=10

# ---- Tap-a-word vocabulary scanner (no language model on this path) --------------------
# Local OCR (RapidOCR on ONNX Runtime, pip-installed): auto | rapidocr | off.
LOCAL_OCR_ENGINE=auto
# Dictionary hint for the multilingual model; the same model reads every Latin-script language.
LOCAL_OCR_LANGUAGE=de
# Load the models in the background at start-up so the first scan is not the slow one.
LOCAL_OCR_WARMUP=true
# Translation providers in order of preference; one without credentials is skipped.
# MyMemory needs no key (about 5,000 characters a day anonymously, 50,000 with an email).
TRANSLATION_PROVIDERS=deepl,libretranslate,mymemory
DEEPL_API_KEY=
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
MYMEMORY_EMAIL=
TRANSLATION_TIMEOUT_SECONDS=4
# Bounded waits for the AI providers (seconds). The SDK defaults were 600 s and two retries.
AI_PROVIDER_TIMEOUT_SECONDS=40
AI_VISION_TIMEOUT_SECONDS=75

# ---- Image understanding: photos in chats, lessons, answers and projects (docs/VISION.md) ----
# Per-image upload limit and pixel ceiling, checked from the file header before decoding.
VISION_MAX_UPLOAD_BYTES=15728640
VISION_MAX_PIXELS=40000000
# Kept copy (enough for an enlarged re-read of one word) and the copy a provider receives.
# Groq documents 4 MB for a base64 image; 2.9 MB raw is 3.87 MB encoded.
VISION_STORAGE_EDGE_PX=2560
VISION_PROVIDER_EDGE_PX=2048
VISION_PROVIDER_MAX_BYTES=2900000
# Optional second vision model (provider:model) tried when the Groq one fails, and any
# further models you vouch can see images. Empty = images only go to GROQ_VISION_MODEL.
# A non-Groq provider also needs its key and an AI_BUDGET_<PROVIDER>_* cap to be used.
AI_VISION_FALLBACK_MODEL=
AI_VISION_MODELS=
# Photos in the assistant, the lesson chat and "photo of my working".
FEATURE_CHAT_IMAGES=true
# Turn sideways landscape photos upright with the local OCR engine (needs RapidOCR).
VISION_LOCAL_ORIENTATION=true
CHAT_IMAGES_PER_MESSAGE=4
# Unsent photos are deleted after a day; sent ones keep their picture this many days
# (the text read from them stays with the conversation until it is deleted).
CHAT_ATTACHMENT_RETENTION_DAYS=30
CHAT_ATTACHMENT_UPLOADS_PER_HOUR=60
AI_IMAGE_UNDERSTANDING_MAX_OUTPUT_TOKENS=5000
AI_IMAGE_UNDERSTANDING_MAX_INPUT_TOKENS=10000

# ---- Google AdSense (docs/ADSENSE.md) ------------------------------------------------
# The publisher id already used in ads.txt. Empty removes the ad code, the verification
# meta tag and /ads.txt.
ADSENSE_CLIENT_ID=ca-pub-5205912301427741
# Set to google_privacy_messaging only after the European regulations message is
# published in AdSense -> Privacy & messaging. Empty = no ad code on any page.
ADSENSE_CMP=
# Ads for signed-in students (many are under 16) - decide with legal advice first.
ADSENSE_SHOW_TO_STUDENTS=false
# Part of Google's only supported AdSense CSP; false only to test without it.
ADSENSE_CSP_UNSAFE_EVAL=true
# Optional https:// collector for CSP violation reports.
CSP_REPORT_URI=
